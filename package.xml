<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mcp_ros2</name>
  <version>0.1.0</version>
  <description>
    An MCP server for ROS 2: it lets AI agents inspect a running ROS 2 system and act on it,
    as a node of its own. Topics, services, actions, parameters and transforms of any installed
    interface type, as JSON.
  </description>
  <maintainer email="yurirocha15@gmail.com">Yuri Rocha</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/yurirocha15/mcp-ros2</url>
  <url type="bugtracker">https://github.com/yurirocha15/mcp-ros2/issues</url>
  <author>Yuri Rocha</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>boost</build_depend>
  <build_depend>nlohmann-json-dev</build_depend>

  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>libssl-dev</depend>
  <depend>mcp_cpp_sdk</depend>
  <depend>rcl</depend>
  <depend>rcl_action</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp</depend>
  <depend version_gte="28.1.18">rclcpp_action</depend>
  <depend>rcpputils</depend>
  <depend>rmw</depend>
  <depend>rosidl_runtime_c</depend>
  <depend>rosidl_runtime_cpp</depend>
  <depend>rosidl_typesupport_cpp</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>example_interfaces</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>test_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
